        "jsCode": "const lead = $input.first().json;\nconst prompt = `Voce e um assistente de reativacao de leads para uma imobiliaria. Seu objetivo e reengajar clientes que demonstraram interesse em imoveis, mas pararam de interagir. Seja amigavel, empatico e direto. Mencione o ultimo imovel de interesse do cliente para personalizar a mensagem. Ofereca ajuda e pergunte se ha algo novo em que ele esteja interessado. Nao faca uma oferta direta.\\n\\nInformacoes do Lead:\\nNome: ${lead.nome}\\nUltimo imovel de interesse: ${lead.ult_imovel_interesse || 'um imovel'}\\n\\nCrie uma mensagem curta e amigavel para o WhatsApp.`;\n\nconst supabasePayload = {\n  lead_id_cvcrm: String(lead.id),\n  telefone: String(lead.telefone),\n  status_reativacao: 'Enviado',\n  data_envio: new Date().toISOString(),\n  corretor_id_cvcrm: String(lead.idcorretor || ''),\n  historico_mensagens: []\n};\n\nreturn [{ json: { lead, prompt, supabasePayload } }];"
      },
