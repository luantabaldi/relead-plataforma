    {
      "parameters": {
        "jsCode": "let results = [];\n\nfor (let item of $input.all()) {\n  // A API pode retornar o array diretamente em item.json ou dentro de propriedades\n  let leadsArray = item.json.leads || item.json.data || item.json;\n  \n  if (Array.isArray(leadsArray)) {\n    for (let lead of leadsArray) {\n      if (lead && lead.id) { // garante que é um objeto lead válido\n        results.push({ json: lead });\n      }\n    }\n  } else if (item.json && item.json.id) {\n     // fallback caso seja um único lead\n     results.push({ json: item.json });\n  }\n}\n\nreturn results;"
      },
