            "url": "=https://reqlxhvjrqqfksrxifwl.supabase.co/rest/v1/leads_reativacao?telefone=in.({{ $json.telefone }},{{ $json.telefone.startsWith('55') ? $json.telefone.substring(2) : $json.telefone }})&status_reativacao=neq.Pendente&limit=1"
          },
          "alwaysOutputData": true,
          "id": "wk3-check-supa",
          "name": "Verificar Se Ja Enviado (Supabase)",
          "position": [
            640,
            32
          ],
          "type": "n8n-nodes-base.httpRequest",
          "typeVersion": 4.2,
          "onError": "continueRegularOutput"
        },
        {
          "parameters": {
            "conditions": {
              "combinator": "and",
              "conditions": [
                {
                  "id": "c1",
                  "leftValue": "={{ Array.isArray($json) ? $json.length : 0 }}",
                  "operator": {
                    "operation": "equals",
                    "type": "number"
                  },
                  "rightValue": 0
                }
              ],
              "options": {
                "caseSensitive": true,
                "leftValue": "",
                "typeValidation": "strict",
                "version": 2
              }
            },
            "options": {}
          },
          "id": "wk3-check-novo",
          "name": "Lead Ja Foi Enviado?",
          "position": [
            864,
            16
          ],
          "type": "n8n-nodes-base.if",
          "typeVersion": 2,
          "onError": "continueErrorOutput"
        },
        {
          "parameters": {
            "jsCode": "const d = $('Processar 1 por Vez').first().json;\nconst agoraObj = new Date();\nconst agora = agoraObj.toISOString();\nconst templateNome = (d.templateNome || '').trim();\n\n// Verificação de horário (America/Sao_Paulo)\nconst horaAtualSP = new Date(agoraObj.toLocaleString('en-US', { timeZone: 'America/Sao_Paulo' }));\nconst horas = horaAtualSP.getHours();\nconst minutos = horaAtualSP.getMinutes();\n\n// Trava de horário: Não enviar antes das 07:00 nem depois das 21:30\nif (horas > 21 || (horas === 21 && minutos >= 30) || horas < 7) {\n  return [{\n    json: {\n      templateValido: false,\n      nome: d.nome,\n      telefone: d.telefone,\n      id: d.id,\n      statusPlanilha: 'Pausado (Horário Excedido)'\n    }\n  }];\n}\n\nif (!templateNome) {\n  return [{\n    json: {\n      templateValido: false,\n      nome: d.nome,\n      telefone: d.telefone,\n      id: d.id,\n      statusPlanilha: 'Erro - Template vazio'\n    }\n  }];\n}\n\nconst primeiroNome = d.primeiroNome || d.nome.split(' ')[0];\nconst tipoCampanha = d.tipoCampanha || 'reativacao';\nconst idEmpreendimento = d.idEmpreendimento || '';\n\n// Setup basic template message\nconst templateMessage = {\n  name: templateNome,\n  language: 'pt_BR',\n  components: []\n};\n\n// Obter configuração dinâmica do template do Supabase\nconst templateResponse = $('Obter Template Supabase').first().json;\nconst templateData = Array.isArray(templateResponse) ? templateResponse[0] : templateResponse;\n\n// Se o template estiver cadastrado e explicitamente disser que NÃO tem variáveis,\n// temVariaveis será falso. Caso contrário (se não achar ou se estiver marcado true), assume true.\nconst temVariaveis = templateData ? (templateData.tem_variaveis !== false) : true;\n\nif (temVariaveis) {\n  templateMessage.components.push({\n    type: 'body',\n    parameters: [{ type: 'text', text: primeiroNome }]\n  });\n}\n\nreturn [{\n  json: {\n    templateValido: true,\n    nome: d.nome,\n    primeiroNome,\n    telefone: d.telefone,\n    id: d.id,\n    leadIdCrm: d.leadIdCrm || '',\n    templateNome,\n    tipoCampanha,\n    observacao: d.observacao || '',\n    idEmpreendimento,\n    statusPlanilha: 'Enviado',\n    evolutionPayload: {\n      number: d.telefone,\n      templateMessage: templateMessage\n    },\n    supabasePayload: {\n      lead_id_cvcrm: d.leadIdCrm || d.telefone,\n      telefone: d.telefone,\n      nome_lead: d.nome,\n      status_reativacao: 'Enviado',\n      tipo_campanha: tipoCampanha,\n      data_envio: agora,\n      corretor_id_cvcrm: null,\n      observacao_crm: d.observacao || null,\n      empreendimento_id: idEmpreendimento || null,\n      historico_mensagens: [{ remetente: 'TEMPLATE_WABA', template: templateNome, mensagem: 'Template: ' + templateNome, timestamp: agora }],\n      mensagem_enviada: 'Template: ' + templateNome + (temVariaveis ? ' | Param: ' + primeiroNome : '')\n    }\n  }\n}];"
          },
