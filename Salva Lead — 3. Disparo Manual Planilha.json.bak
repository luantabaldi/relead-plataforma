            },
            "options": {},
            "sendHeaders": true,
            "url": "https://reqlxhvjrqqfksrxifwl.supabase.co/rest/v1/leads_reativacao?status_reativacao=eq.Pendente"
          },
          "id": "wk3-read-sheet",
          "name": "Ler Leads Pendentes Supabase",
          "position": [
            -256,
            -40
          ],
          "type": "n8n-nodes-base.httpRequest",
          "typeVersion": 4.2,
          "onError": "continueRegularOutput"
        },
        {
          "parameters": {
            "jsCode": "const rows = $input.all();\nconst results = [];\n\nfor (const row of rows) {\n  const d = row.json;\n\n  const status = (d.status_reativacao || '').trim();\n  if (status !== 'Pendente') continue;\n\n  const nome = (d.nome_lead || '').trim();\n  let telefone = (d.telefone || '').toString().trim();\n  const id = d.id || '';\n\n  if (!nome || !telefone) continue;\n\n  telefone = telefone.replace(/\\D/g, '');\n\n  if (!telefone.startsWith('55')) {\n    if (telefone.length === 11) {\n      telefone = '55' + telefone;\n    } else if (telefone.length === 10) {\n      const ddd = telefone.substring(0, 2);\n      const num = telefone.substring(2);\n      telefone = '55' + ddd + '9' + num;\n    }\n  }\n\n  const primeiroNome = nome.split(' ')[0];\n  const leadIdCrm = (d.lead_id_cvcrm || '').toString();\n  const templateNome = (d.mensagem_enviada || '').toString().trim();\n  const observacao = (d.observacao_crm || '').toString().trim();\n  const tipoCampanha = (d.tipo_campanha || 'reativacao').toString().trim();\n  const idEmpreendimento = (d.empreendimento_id || '').toString().trim();\n\n  results.push({ json: { nome, primeiroNome, telefone, id, leadIdCrm, templateNome, observacao, tipoCampanha, idEmpreendimento } });\n}\n\nif (results.length === 0) {\n  return [{ json: { nenhum_pendente: true, total: 0 } }];\n}\n\nreturn results;"
          },
          "id": "wk3-validar-linha",
          "name": "Validar e Normalizar Linha",
          "position": [
            -32,
            8
          ],
          "type": "n8n-nodes-base.code",
          "typeVersion": 2
        },
